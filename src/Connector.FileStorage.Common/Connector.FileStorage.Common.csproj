    <InternalsVisibleTo Include="CluedIn.Connector.FileStorage.Common.Tests.Integration" />
    <InternalsVisibleTo Include="CluedIn.Connector.DataLake.Common.Tests.Integration" />
    <InternalsVisibleTo Include="CluedIn.Connector.AmazonS3.Tests.Integration" />
