    <InternalsVisibleTo Include="CluedIn.Connector.AzureDatabricks" />
    <InternalsVisibleTo Include="CluedIn.Connector.AzureDataLake" />
    <InternalsVisibleTo Include="CluedIn.Connector.FabricOpenMirroring" />
    <InternalsVisibleTo Include="CluedIn.Connector.OneLake" />
